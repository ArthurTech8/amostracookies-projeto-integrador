# Copie para backend/.env e preencha. Nunca versione o .env.
# Se backend/.env não existir, o backend também lê o .env da raiz do repositório.

# Banco PostgreSQL de desenvolvimento (compartilhado pelo time no alwaysdata)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DB_SSL=true

# JWT
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio
# Duração do token: número + s, m, h ou d (ex.: 30m, 8h, 1d)
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Seed do super admin (npm run seed:super-admin)
# Cada dev usa um usuário próprio, ex.: maria. Nunca compartilhe a senha.
SUPER_ADMIN_USERNAME=seu-usuario
SUPER_ADMIN_PASSWORD=troque-esta-senha
SUPER_ADMIN_NAME=Seu Nome
